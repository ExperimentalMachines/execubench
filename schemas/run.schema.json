{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ExperimentalMachines/execubench/schemas/run.schema.json",
  "title": "Job",
  "description": "One Device Farm job: one device unit, one model file, one or more tracks. Written by the harness on the test host at job start and completed at job end; every request record points back to it.",
  "type": "object",
  "required": [
    "job_id",
    "provider",
    "device_id",
    "device_unit",
    "build_fingerprint",
    "model",
    "tokenizer_sha256",
    "runtime",
    "harness",
    "protocol",
    "tracks",
    "started_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Device Farm job ARN suffix"
    },
    "provider": {
      "type": "object",
      "required": [
        "run_arn",
        "job_arn",
        "device_arn"
      ],
      "additionalProperties": false,
      "properties": {
        "run_arn": {
          "type": "string"
        },
        "job_arn": {
          "type": "string"
        },
        "device_arn": {
          "type": "string"
        },
        "host_os": {
          "type": "string"
        },
        "adb_version": {
          "type": "string"
        },
        "device_minutes": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "device_id": {
      "type": "string",
      "description": "Foreign key into data/devices/devices.json: model, Android version and build fingerprint hash"
    },
    "device_unit": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "First 16 hex digits of sha256(salt + DEVICEFARM_DEVICE_UDID): tells units apart without publishing serials"
    },
    "build_fingerprint": {
      "type": "string",
      "description": "ro.build.fingerprint at job time; Device Farm may update a unit between jobs"
    },
    "model": {
      "$ref": "common.schema.json#/$defs/model_ref"
    },
    "tokenizer_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "runtime": {
      "type": "object",
      "required": [
        "executorch",
        "server",
        "server_commit",
        "apk_sha256",
        "requested_threads",
        "effective_threads",
        "kv_reuse"
      ],
      "additionalProperties": false,
      "properties": {
        "executorch": {
          "type": "string",
          "description": "AAR version, e.g. 1.4.0"
        },
        "server": {
          "const": "execuserve"
        },
        "server_commit": {
          "$ref": "common.schema.json#/$defs/git_sha"
        },
        "apk_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "kv_reuse": {
          "enum": [
            "off",
            "on"
          ],
          "description": "off for single-turn and speed tracks, on for multi-turn"
        },
        "requested_threads": {
          "type": "integer",
          "minimum": 0,
          "description": "0 means the runtime chooses"
        },
        "effective_threads": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "As reported by ExecuServe after load"
        }
      }
    },
    "harness": {
      "type": "object",
      "required": [
        "commit",
        "suite",
        "suite_manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "common.schema.json#/$defs/git_sha"
        },
        "suite": {
          "type": "string",
          "description": "e.g. v1"
        },
        "suite_manifest_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "shard": {
          "type": "string",
          "description": "e.g. gsm8k[0:120]"
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "fixed_performance_mode",
        "cooldown",
        "warmup_requests",
        "sampling_period_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "fixed_performance_mode": {
          "type": "boolean"
        },
        "fixed_performance_mode_accepted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cooldown": {
          "type": "object",
          "required": [
            "max_battery_c",
            "max_wait_s"
          ],
          "properties": {
            "max_battery_c": {
              "type": "number"
            },
            "max_skin_c": {
              "type": [
                "number",
                "null"
              ]
            },
            "max_wait_s": {
              "type": "integer"
            }
          }
        },
        "warmup_requests": {
          "type": "integer"
        },
        "screen": {
          "enum": [
            "on",
            "off"
          ]
        },
        "proc_status_readable": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether the shell could read the server's /proc/<pid>/status"
        },
        "sampling_period_ms": {
          "type": "integer"
        },
        "protocol_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "enum": [
          "speed",
          "quality",
          "long-context",
          "agreement"
        ]
      }
    },
    "started_utc": {
      "type": "string",
      "format": "date-time"
    },
    "finished_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "description": "complete requires finalized: true; partial and failed jobs may be finalized with unverified staging"
    },
    "failure": {
      "type": [
        "string",
        "null"
      ]
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download_s": {
          "type": "number"
        },
        "push_s": {
          "type": "number"
        },
        "sha256_verified_on_device": {
          "type": "boolean"
        },
        "load_ms": {
          "type": "integer"
        },
        "sha256_verified_on_host": {
          "type": "boolean"
        }
      }
    },
    "artifact_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Size of the job's customer artifacts; Device Farm drops all of them above 1 GB"
    },
    "generation": {
      "type": "object",
      "description": "Every setting that changes what the model is asked to do",
      "required": [
        "temperature",
        "thinking",
        "max_tokens_policy",
        "eos_policy",
        "chat_template_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "thinking": {
          "enum": [
            "off",
            "on",
            "not_applicable"
          ]
        },
        "max_tokens_policy": {
          "type": "string",
          "description": "How the output cap is enforced, e.g. 'native max_new_tokens' or 'server stop() after N callbacks'"
        },
        "eos_policy": {
          "enum": [
            "stop_on_eos",
            "exclude_early_stop"
          ]
        },
        "chat_template_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "config_sha256": {
      "$ref": "common.schema.json#/$defs/sha256",
      "description": "sha256 of the canonical JSON of model, runtime, generation and protocol: two jobs with the same hash ran the same configuration"
    },
    "finalized": {
      "type": "boolean",
      "description": "Set when the job record is complete; a finalized record must carry the fields a published number needs"
    },
    "planned_requests": {
      "type": "integer",
      "minimum": 1,
      "description": "Requests the job's workload plans (warm-up excluded); a complete job recorded exactly this many in requests.jsonl"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "finalized": {
            "const": true
          }
        },
        "required": [
          "finalized"
        ]
      },
      "then": {
        "required": [
          "finished_utc",
          "outcome",
          "staging",
          "generation",
          "config_sha256",
          "planned_requests"
        ],
        "properties": {
          "finished_utc": {
            "type": "string"
          },
          "protocol": {
            "required": [
              "protocol_sha256"
            ]
          },
          "staging": {
            "required": [
              "sha256_verified_on_host",
              "sha256_verified_on_device"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "complete"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "finalized"
        ],
        "properties": {
          "finalized": {
            "const": true
          },
          "staging": {
            "properties": {
              "sha256_verified_on_host": {
                "const": true
              },
              "sha256_verified_on_device": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}

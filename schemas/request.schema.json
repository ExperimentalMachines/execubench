{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ExperimentalMachines/execubench/schemas/request.schema.json",
  "title": "Request",
  "description": "One generation: one assistant turn. Lines of requests.jsonl in a job's artifacts. Grading fields are added on our machine afterwards and never on the device or the test host. A request with status ok must carry the runner's raw stats, the monotonic duration and the prompt hash, or it cannot be published.",
  "type": "object",
  "required": [
    "job_id",
    "seq",
    "track",
    "item",
    "timings",
    "tokens",
    "memory",
    "state",
    "output",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "description": "Order within the job, from 0"
    },
    "track": {
      "enum": [
        "warmup",
        "speed",
        "quality",
        "long-context",
        "agreement"
      ]
    },
    "item": {
      "type": "object",
      "required": [
        "dataset",
        "row_id"
      ],
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "type": "string",
          "description": "gsm8k, ifeval, multi-if, bfcl-v4/<category>, retrievalqa/<mode>, ruler/<task>, speed"
        },
        "row_id": {
          "type": "string"
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_bucket": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Speed track: target prompt length in tokens"
        },
        "max_tokens": {
          "type": "integer"
        },
        "prompt_sha256": {
          "$ref": "common.schema.json#/$defs/sha256",
          "description": "sha256 of the exact rendered prompt bytes (from /apply-template)"
        },
        "decode_target": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Speed track: decode steps targeted (the request asks for decode_target + 1 sampled tokens)"
        },
        "prompt_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "The exact rendered prompt bytes as UTF-8, kept in raw artifacts so a request can be replayed; publication follows the dataset's license"
        },
        "eligible": {
          "type": "boolean",
          "description": "Whether the row was eligible for this model when the suite was frozen (prompt plus cap fits the window)"
        },
        "answer_in_context": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "RetrievalQA: whether any gold answer string appears in the passages actually given"
        },
        "retained_passages": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "description": "RetrievalQA: sha256 of each passage given, in order"
        }
      }
    },
    "timings": {
      "type": "object",
      "required": [
        "ttft_ms",
        "decode_ms",
        "e2e_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "runner": {
          "type": "object",
          "description": "The runner's stats JSON, verbatim; these members are required, others are kept as reported",
          "required": [
            "inference_start_ms",
            "prompt_eval_end_ms",
            "first_token_ms",
            "inference_end_ms",
            "prompt_tokens",
            "generated_tokens"
          ],
          "properties": {
            "inference_start_ms": {
              "type": "integer"
            },
            "prompt_eval_end_ms": {
              "type": "integer"
            },
            "first_token_ms": {
              "type": "integer"
            },
            "inference_end_ms": {
              "type": "integer"
            },
            "prompt_tokens": {
              "type": "integer"
            },
            "generated_tokens": {
              "type": "integer"
            }
          }
        },
        "ttft_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "decode_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "e2e_ms": {
          "type": "integer"
        },
        "client_ttft_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "queue_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "prefill_tps": {
          "type": [
            "number",
            "null"
          ],
          "description": "null when ttft_ms < 50 (docs/METRICS.md validity rules)"
        },
        "decode_tps": {
          "type": [
            "number",
            "null"
          ],
          "description": "null when decode_ms < 250 or decode_steps < 16"
        },
        "clock_disagreement": {
          "type": "boolean",
          "description": "Any stage (TTFT, decode) where the runner's CLOCK_REALTIME duration and the monotonic duration differ by more than 5 ms plus 1 percent"
        },
        "monotonic": {
          "type": "object",
          "description": "ExecuServe's own monotonic timestamps (elapsedRealtimeNanos) at runner call start, first token callback and runner return, as durations",
          "required": [
            "start_to_first_token_ms",
            "first_token_to_end_ms",
            "total_ms"
          ],
          "additionalProperties": false,
          "properties": {
            "start_to_first_token_ms": {
              "type": "number"
            },
            "first_token_to_end_ms": {
              "type": "number"
            },
            "total_ms": {
              "type": "number"
            }
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "prefill",
        "cached",
        "decode_steps",
        "sampled"
      ],
      "additionalProperties": false,
      "properties": {
        "prefill": {
          "type": "integer"
        },
        "cached": {
          "type": "integer"
        },
        "decode_steps": {
          "type": "integer"
        },
        "sampled": {
          "type": "integer",
          "description": "decode_steps + 1, including special and end-of-sequence tokens"
        }
      }
    },
    "memory": {
      "type": "object",
      "required": [
        "rss_sampled_peak_mib",
        "rss_mean_mib",
        "samples"
      ],
      "additionalProperties": false,
      "properties": {
        "rss_sampled_peak_mib": {
          "type": [
            "number",
            "null"
          ]
        },
        "rss_mean_mib": {
          "type": [
            "number",
            "null"
          ]
        },
        "rss_anon_mib": {
          "type": [
            "number",
            "null"
          ]
        },
        "rss_file_mib": {
          "type": [
            "number",
            "null"
          ]
        },
        "pss_total_mib": {
          "type": [
            "number",
            "null"
          ]
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "null_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why memory is absent, e.g. proc_status_unreadable"
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "battery_temp_c_start",
        "battery_temp_c_end",
        "thermal_status_max",
        "thermal_event",
        "clock_drop"
      ],
      "additionalProperties": false,
      "properties": {
        "battery_temp_c_start": {
          "type": [
            "number",
            "null"
          ]
        },
        "battery_temp_c_end": {
          "type": [
            "number",
            "null"
          ]
        },
        "skin_temp_c_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "soc_temp_c_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "thermal_status_max": {
          "type": [
            "integer",
            "null"
          ]
        },
        "thermal_event": {
          "type": "boolean",
          "description": "Any sampled thermal status above 0 during the request"
        },
        "clock_drop": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Top clock domain's median decode-phase clock more than 15 percent below the cell's first request in this job; null for that first request"
        },
        "top_domain_mhz_median": {
          "type": [
            "number",
            "null"
          ]
        },
        "cooldown_wait_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "null_reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why a state reading is missing"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "text",
        "finish_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "reasoning": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "finish_reason": {
          "enum": [
            "stop",
            "length",
            "tool_calls",
            "error",
            "timeout",
            "context_overflow"
          ]
        },
        "tool_trace": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Multi-turn tool loops: each call, the simulator's result and its state after the call, in order"
        },
        "token_ids": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "description": "Sampled token ids, when the runtime exposes them (not in ExecuServe 1.4.0-based builds; P1 decides)"
        }
      }
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "timeout",
        "context_overflow",
        "skipped"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "grade": {
      "type": "object",
      "description": "Added on our machine by `execubench grade`",
      "additionalProperties": false,
      "properties": {
        "grader": {
          "type": "string",
          "description": "Grader name and pinned version"
        },
        "correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "scores": {
          "type": "object"
        },
        "tool_call_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_call_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "format_failure": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_decision_vs_label": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_decision_vs_own": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "timings": {
            "required": [
              "runner",
              "ttft_ms",
              "decode_ms",
              "e2e_ms",
              "monotonic",
              "clock_disagreement"
            ]
          },
          "item": {
            "required": [
              "dataset",
              "row_id",
              "prompt_sha256",
              "prompt_text",
              "max_tokens"
            ],
            "properties": {
              "prompt_text": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "memory": {
            "allOf": [
              {
                "anyOf": [
                  {
                    "properties": {
                      "rss_sampled_peak_mib": {
                        "type": "number"
                      },
                      "rss_mean_mib": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "rss_sampled_peak_mib",
                      "rss_mean_mib"
                    ]
                  },
                  {
                    "properties": {
                      "null_reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "null_reason"
                    ]
                  }
                ]
              },
              {
                "anyOf": [
                  {
                    "properties": {
                      "samples": {
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "required": [
                      "null_reason"
                    ],
                    "properties": {
                      "null_reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "properties": {
                  "battery_temp_c_start": {
                    "type": "number"
                  },
                  "battery_temp_c_end": {
                    "type": "number"
                  }
                },
                "required": [
                  "battery_temp_c_start",
                  "battery_temp_c_end"
                ]
              },
              {
                "properties": {
                  "null_reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "null_reason"
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "track": {
            "const": "speed"
          }
        },
        "required": [
          "track"
        ]
      },
      "then": {
        "properties": {
          "item": {
            "required": [
              "prompt_bucket",
              "decode_target"
            ],
            "properties": {
              "prompt_bucket": {
                "type": "integer"
              },
              "decode_target": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "item": {
            "properties": {
              "dataset": {
                "pattern": "^retrievalqa/"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "item": {
            "required": [
              "answer_in_context",
              "retained_passages"
            ]
          }
        }
      }
    }
  ]
}

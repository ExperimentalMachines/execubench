{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ExperimentalMachines/execubench/schemas/sample.schema.json",
  "title": "State sample",
  "description": "One line of samples.jsonl: the host's periodic reading of the server process and the phone during a job.",
  "type": "object",
  "required": [
    "job_id",
    "t_ns",
    "t_start_ns",
    "t_end_ns",
    "kind",
    "seq"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string"
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Always null when written; requests are matched to samples by host time afterwards"
    },
    "t_ns": {
      "type": "integer",
      "description": "Midpoint of the read, host monotonic (time.monotonic_ns)",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "memory",
        "clock",
        "thermal"
      ]
    },
    "vm_rss_kib": {
      "type": [
        "integer",
        "null"
      ]
    },
    "rss_anon_kib": {
      "type": [
        "integer",
        "null"
      ]
    },
    "rss_file_kib": {
      "type": [
        "integer",
        "null"
      ]
    },
    "vm_hwm_kib": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cpu_cur_khz": {
      "type": [
        "object",
        "null"
      ],
      "description": "cpu index -> scaling_cur_freq"
    },
    "thermal_status": {
      "type": [
        "integer",
        "null"
      ]
    },
    "temps_c": {
      "type": [
        "object",
        "null"
      ],
      "description": "HAL current temperatures by sensor name"
    },
    "battery_temp_c": {
      "type": [
        "number",
        "null"
      ]
    },
    "t_start_ns": {
      "type": "integer",
      "minimum": 0
    },
    "t_end_ns": {
      "type": "integer",
      "minimum": 0
    },
    "raw": {
      "type": [
        "string",
        "null"
      ],
      "description": "The command output the values were parsed from (status file, clock listing or the whole thermalservice dump); null when the command itself failed"
    },
    "read_error": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "description": "Why this read has no values: an adb failure or output that did not parse. null when the read succeeded"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "thermal"
          },
          "read_error": {
            "type": "null"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "thermal_status"
            ],
            "properties": {
              "thermal_status": {
                "type": "integer"
              }
            }
          },
          {
            "required": [
              "temps_c"
            ],
            "properties": {
              "temps_c": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "memory"
          },
          "read_error": {
            "type": "null"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "vm_rss_kib"
        ],
        "properties": {
          "vm_rss_kib": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "clock"
          },
          "read_error": {
            "type": "null"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "cpu_cur_khz"
        ],
        "properties": {
          "cpu_cur_khz": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  ]
}

# The runtime every benchmark targets, and the host runtime that must match it. One place, so
# docs, requirements and the phone build cannot drift apart (tests/test_versions.py checks).
#
# EXECUTORCH_VERSION is the runtime on the phone (Maven org.pytorch:executorch-android, used
# by ExecuServe) and on the host (PyPI executorch). 1.5.1 is the first 1.5 release on Maven;
# Maven has no 1.5.0. TORCH_VERSION is the torch the 1.5.1 wheel was built against
# (torch_pin.py at the v1.5.1 tag); the wheel does not declare it, so it is pinned here.
EXECUTORCH_VERSION=1.5.1
EXECUTORCH_TAG_COMMIT=3b60683923245cf472b7323426920e15623ba361
TORCH_VERSION=2.14.0
PYTHON_VERSION=3.12
